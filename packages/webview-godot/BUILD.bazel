load("//build:module_rules.bzl", "engine_sdk_distribution")
load("//packages/webview-godot:build/godot_adapter.bzl", "godot_adapter", "godot_binding")

godot_adapter(
    name = "adapter",
    api_contract = "//packages/webview-core:api_contract",
    compatibility = "//compatibility:compatibility.json",
    entries = {
        "src/adapter/diagnostic_detail.gd": "addons/verve_webview/diagnostic_detail.gd",
        "src/adapter/geometry_converter.gd": "addons/verve_webview/geometry_converter.gd",
        "src/adapter/godot_binding_registry.gd": "addons/verve_webview/godot_binding_registry.gd",
        "src/adapter/godot_environment.gd": "addons/verve_webview/godot_environment.gd",
        "src/adapter/webview.gd": "addons/verve_webview/webview.gd",
        "src/adapter/webview_options.gd": "addons/verve_webview/webview_options.gd",
    },
    visibility = ["//visibility:private"],
)

godot_binding(
    name = "binding_android",
    adapter = ":adapter",
    backend = "//packages/webview-android:backend",
    compatibility = "//compatibility:compatibility.json",
    platform = "android",
    visibility = ["//visibility:private"],
)

godot_binding(
    name = "binding_ios",
    adapter = ":adapter",
    backend = "//packages/webview-ios:backend",
    compatibility = "//compatibility:compatibility.json",
    platform = "ios",
    visibility = ["//visibility:private"],
)

godot_binding(
    name = "binding_windows",
    adapter = ":adapter",
    backend = "//packages/webview-windows:backend",
    compatibility = "//compatibility:compatibility.json",
    platform = "windows",
    visibility = ["//visibility:private"],
)

godot_binding(
    name = "binding_web",
    adapter = ":adapter",
    backend = "//packages/webview-web:backend",
    compatibility = "//compatibility:compatibility.json",
    platform = "web",
    visibility = ["//packages/webview-core:__pkg__"],
)

engine_sdk_distribution(
    name = "sdk",
    engine = "godot",
    adapter = ":adapter",
    android = ":binding_android",
    ios = ":binding_ios",
    windows = ":binding_windows",
    web = ":binding_web",
    release_version = "//build:release_version",
    target_compatible_with = ["//build/platforms:canonical_aggregation_capability"],
    visibility = ["//visibility:public"],
)

sh_test(
    name = "adapter_test",
    srcs = ["tests/run_godot_tests.sh"],
    data = [
        "//packages/webview-core:godot_contract_snapshot",
    ] + glob([
        "src/adapter/*.gd",
        "tests/project/*.gd",
        "tests/project/project.godot",
    ]),
    tags = [
        "manual",
        "no-sandbox",
    ],
)
