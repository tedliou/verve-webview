{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tedliou.github.io/verve-webview/schemas/release-evidence-v1.json",
  "title": "Verve WebView Release Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "candidate",
    "environment",
    "suite_version",
    "results"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sdk_version", "artifacts"],
      "properties": {
        "sdk_version": {"type": "string"},
        "artifacts": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "sha256"],
            "properties": {
              "id": {"enum": ["unity.tgz", "unity.zip", "godot.zip"]},
              "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
            }
          }
        }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "engine",
        "engine_version",
        "profile",
        "platform",
        "architecture",
        "os",
        "toolchain",
        "runtime"
      ],
      "properties": {
        "engine": {"enum": ["unity", "godot"]},
        "engine_version": {"type": "string"},
        "profile": {"type": "string"},
        "platform": {"enum": ["android", "ios", "windows", "web"]},
        "architecture": {"type": "string"},
        "os": {"type": "string"},
        "toolchain": {"type": "object"},
        "runtime": {
          "type": "object",
          "required": ["name", "version"],
          "properties": {
            "name": {"type": "string", "minLength": 1},
            "version": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "suite_version": {"type": "string"},
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["suite", "result"],
        "properties": {
          "suite": {"type": "string"},
          "result": {"enum": ["passed", "failed", "unverified"]},
          "evidence": {"type": "string"}
        }
      }
    }
  }
}
