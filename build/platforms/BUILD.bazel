package(default_visibility = ["//visibility:public"])

constraint_setting(name = "runtime")

constraint_value(
    name = "web",
    constraint_setting = ":runtime",
)

constraint_setting(name = "aggregation")

constraint_value(
    # A platform() target and its constraint_value() cannot share one Bazel
    # label. Keep the architecture's fixed transition target name below and
    # give this private compatibility value a descriptive suffix.
    name = "canonical_aggregation_capability",
    constraint_setting = ":aggregation",
)

platform(
    name = "release_android_arm64",
    constraint_values = [
        "@platforms//cpu:aarch64",
        "@platforms//os:android",
    ],
)

platform(
    name = "release_ios_xcframework",
    constraint_values = [
        "@platforms//cpu:aarch64",
        "@platforms//os:ios",
    ],
)

platform(
    name = "release_windows_x86_64",
    constraint_values = [
        "@platforms//cpu:x86_64",
        "@platforms//os:windows",
    ],
)

platform(
    name = "release_web_wasm32",
    constraint_values = [
        ":web",
        "@platforms//cpu:wasm32",
    ],
)

platform(
    name = "canonical_aggregation",
    constraint_values = [
        ":canonical_aggregation_capability",
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
    ],
)
